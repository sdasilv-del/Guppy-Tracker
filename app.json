{
  "expo": {
    "name": "Guppy Tracker",
    "slug": "guppy-tracker",
    "owner": "sdasilv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "guppytracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ca.guppytracker.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ca.guppytracker.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1628",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1628",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Guppy Tracker uses the camera to scan tank QR codes and photograph your fish.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Guppy Tracker lets you choose fish photos from your library.",
          "cameraPermission": "Guppy Tracker uses the camera to photograph your fish."
        }
      ],
      "expo-sharing",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "5871adc4-66f6-493c-8bce-ac99fbdbf877"
      }
    }
  }
}
